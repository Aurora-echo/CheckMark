<?xml version="1.0" encoding="utf-8"?>
<!--
    小部件背景形状定义
    这个文件定义了小部件的背景样式，包括圆角和边框
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 设置背景为白色 -->
    <solid android:color="@color/white" />

    <!-- 设置圆角，让四个角都是圆形的 -->
    <corners android:radius="12dp" />

    <!-- 设置边框：1dp宽度，灰色 -->
    <stroke
        android:width="1dp"
        android:color="@color/gray" />

    <!-- 设置内边距 -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>